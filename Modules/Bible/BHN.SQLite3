                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  6òzgÚNawatakieni nyote neema ya Bwana Yesu. Amina.uòycÚNaye anayetoa ushahidi wake juu ya mambo haya asema: <J>â€œKweli naja upesi.â€</J> Amina. Njoo Bwana Yesu!eòxƒCÚNa mtu yeyote akipunguza chochote katika maneno ya unabii yaliyomo katika kitabu hiki, Mungu atamnyang'anya sehemu yake katika ule mti wa uhai, na sehemu yake katika mji mtakatifu, ambavyo vimeelezwa katika kitabu hiki.KòwƒÚMimi Yohane nawapa onyo wote wanaosikia maneno ya unabii yaliyomo katika kitabu hiki: Mtu yeyote akiongeza chochote katika mambo haya, Mungu atamwongezea mabaa yaliyoandikwa katika kitabu hiki.$òv‚AÚRoho na Bibi arusi waseme, â€œNjoo!â€ Kila mtu asikiaye hili, na aseme, â€œNjoo!â€ Aliye na kiu na aje; anayependa, na achukue maji ya uhai bila malipo.(òu‚IÚ<J>â€œMimi, Yesu, nimemtuma malaika wangu awathibitishieni mambo haya katika makanisa. Mimi ni mzawa wa ukoo wa Daudi. Mimi ni nyota angavu ya asubuhi!â€</J>{òtoÚ<J>Lakini mbwa, wachawi, wazinzi, wauaji, waabudu sanamu na wote wanaopenda kusema uongo, watakaa nje ya mji.</J>òs‚+Ú<J>Heri yao wale wanaoosha mavazi yao, wapate kuwa na haki ya kula tunda la mti wa uhai, na haki ya kuingia mjini kwa kupitia milango yake.</J>Tòr!Ú
<J>Mimi ni Alfa na Omega, wa kwanza na wa mwisho, mwanzo na mwisho.â€</J>{òqoÚ<J>â€œSikiliza!â€ Asema Yesu, â€œNaja upesi pamoja na tuzo nitakalompa kila mmoja kufuatana na matendo yake.</J>@òp‚yÚKwa sasa anayetenda mabaya na aendelee kutenda mabaya, na aliye mchafu aendelee kuwa mchafu. Mwenye kutenda mema na azidi kutenda mema, na aliye mtakatifu na azidi kuwa mtakatifu.â€òo‚Ú
Tena akaniambia, â€œUsiyafiche kama siri maneno ya unabii yaliyomo katika kitabu hiki, maana wakati wa kutimizwa kwake umekaribia.(òn‚IÚ	Lakini yeye akaniambia, â€œAcha! Mimi ni mtumishi tu kama wewe na ndugu zako manabii na wote wanaoyatii maagizo yaliyomo katika kitabu hiki. Mwabudu Mungu!â€2òm‚]ÚMimi Yohane, niliyaona na kusikia mambo haya. Nilipokwisha sikia na kuona, nikajitupa chini mbele ya miguu ya huyo malaika aliyenionesha mambo hayo, nikataka kumwabudu.ròl]Ú<J>â€œSikiliza! Naja upesi. Heri yake anayeyazingatia maneno ya unabii yaliyo katika kitabu hiki.â€</J>NòkƒÚKisha malaika akaniambia, â€œManeno haya ni ya kweli na ya kuaminika. Bwana Mungu ambaye huwapa manabii Roho wake, alimtuma malaika wake awaoneshe watumishi wake mambo ambayo lazima yatukie punde.
òj‚ÚUsiku hautakuwako tena, wala hawatahitaji mwanga wa taa au wa jua, maana Bwana Mungu atawaangazia, nao watatawala milele na milele.OòiÚWatauona uso wake, na jina lake litaandikwa juu ya paji za nyuso zao..òh‚UÚHapana kitu chochote kilicholaaniwa kitakachokuwa katika mji huo. Kiti cha enzi cha Mungu na cha Mwanakondoo kitakuwa katika mji huo, na watumishi wake watamwabudu.iògƒKÚMto huo ulitiririka kupitia katikati ya barabara kuu ya mji. Kandokando ya mto huo kulikuwa na mti wa uhai unaozaa matunda mara kumi na mbili kwa mwaka, yaani kila mwezi; na majani yake ni dawa ya kuwaponya watu wa mataifa.òf	ÚKisha malaika akanionesha mto wa maji ya uhai maangavu kama kioo, yakitoka kwenye kiti cha enzi cha Mungu na Mwanakondoo.dòeƒAÚLakini hakuna chochote kilicho najisi kitakachoingia humo; wala mtu yeyote atendaye mambo ya kuchukiza au ya uongo hataingia humo. Ni wale tu walioandikwa katika kitabu cha uhai cha Mwanakondoo ndio watakaoingia ndani.BòdÚFahari na utajiri wa watu wa mataifa utaletwa humo ndani.Vòc%ÚMilango ya mji huo itakuwa wazi mchana wote; maana hakutakuwa na usiku humo.còb?ÚWatu wa mataifa watatembea katika mwanga wake na wafalme wa dunia watauletea utajiri wao.zòamÚMji huo hauhitaji jua wala mwezi kuuangazia, maana utukufu wa Mungu huuangazia, na taa yake ni yule Mwanakondoo.mò`SÚSikuona hekalu katika mji huo, maana Bwana Mungu Mwenye Nguvu na yule Mwanakondoo ndio hekalu lake.Bò_‚}ÚNa ile milango kumi na miwili ilikuwa lulu kumi na mbili; kila mlango ulikuwa umetengenezwa kwa lulu moja. Barabara kuu ya mji ilikuwa imetengenezwa kwa dhahabu safi, angavu kama kioo./ò^‚WÚla tano sardoniki, la sita akiki, la saba krisolito, la nane zabarajadi, la tisa topazi, la kumi krisopraso, la kumi na moja yasintho, na la kumi na mbili amethisto._ò]ƒ7ÚMawe ya msingi wa ukuta huo yalikuwa yamepambwa kwa kila aina ya mawe ya thamani. Jiwe la kwanza la msingi lilikuwa jiwe la thamani jekundu, la pili johari ya rangi ya samawati, la tatu kalkedoni, la nne zumaridi,ò\‚ÚUkuta huo ulikuwa umejengwa kwa mawe mekundu ya thamani, na mji wenyewe ulikuwa umejengwa kwa dhahabu safi, angavu kama kioo.zò[mÚKisha akaupima ukuta wake pia; nao ulikuwa mita 60 kwa kipimo cha macho cha kibinadamu ambacho malaika alitumia.+òZ‚OÚMji wenyewe ulikuwa wa mraba, upana na urefu wake sawa. Basi, malaika akaupima mji huo kwa kijiti chake: Ulikuwa na urefu, upana na kimo cha kama kilomita 2,400.òY‚'ÚBasi, yule malaika aliyekuwa anasema nami alikuwa na kijiti cha dhahabu cha kupimia, kwa ajili ya kuupima huo mji, milango yake na kuta zake.=òX‚sÚKuta za mji huo zilikuwa zimejengwa juu ya mawe ya msingi kumi na mawili, na juu ya kila jiwe palikuwa pameandikwa mojawapo ya majina ya wale mitume kumi na wawili wa Mwanakondoo.!òW‚;Ú
Kila upande ulikuwa na milango mitatu: Upande wa mashariki milango mitatu, kaskazini milango mitatu, kusini milango mitatu na magharibi milango mitatu.FòVƒÚUlikuwa na ukuta mrefu na mkubwa, wenye milango kumi na miwili, na kila mmoja ulilindwa na malaika. Juu ya kila mlango paliandikwa mojawapo ya majina ya makabila kumi na mawili ya Israeli.zòUmÚuking'aa kwa utukufu wa Mungu. Mwangaza wake ulikuwa kama wa jiwe la thamani kubwa kama yaspi, angavu kama kioo.òT‚Ú
Basi, Roho akanikumba, naye malaika akanipeleka juu ya mlima mrefu sana. Akanionesha mji mtakatifu, ukishuka kutoka kwa Mungu mbinguni,DòSƒÚ	Kisha mmoja wa wale malaika saba waliokuwa na yale mabakuli saba yaliyokuwa yamejaa mabaa saba ya mwisho, akaja na kuniambia, â€œNjoo! Nami nitakuonesha bibi arusi, mkewe Mwanakondoo!â€YòRƒ+ÚLakini watu waoga, wasioamini, wapotovu, wauaji, wazinzi, wachawi, waabudu sanamu, na waongo wote, mahali pao patakuwa ndani ya lile ziwa linalowaka moto na madini ya kiberiti; hicho ndicho kifo cha pili.â€YòQ+ÚMshindi yeyote atapokea hicho, nami nitakuwa Mungu wake, naye atakuwa mwanangu."òP‚=ÚKisha akaniambia, â€œYametimia! Mimi ni Alfa na Omega, Mwanzo na Mwisho. Aliye na kiu nitampa kinywaji cha bure kutoka katika chemchemi ya maji ya uhai.7òO‚gÚKisha yule aliyeketi juu ya kiti cha enzi akasema, â€œTazama, nafanya yote mapya.â€ Tena akaniambia, â€œAndika jambo hili, maana maneno haya ni ya kuaminika na ya kweli!â€òN‚ÚYeye atayafuta machozi yao yote; maana kifo hakitakuwako tena, wala uchungu, wala kilio, wala maumivu; maana ile hali ya kale imepita!â€5òM‚cÚKisha nikasikia sauti kubwa kutoka katika kiti cha enzi ikisema, â€œTazama! Maskani ya Mungu kati ya watu. Atakaa kati yao, nao watakuwa watu wake, naye atakuwa Mungu wao.)òL‚KÚNikaona mji mtakatifu, Yerusalemu mpya, ukishuka kutoka kwa Mungu mbinguni. Ulikuwa umetayarishwa vizuri kama bibi arusi aliyepambwa tayari kukutana na mumewe.òK	‚!ÚKisha, nikaona mbingu mpya na dunia mpya. Mbingu ile ya kwanza na dunia ile ya kwanza vilikuwa vimetoweka, nayo bahari pia haikuwako tena.vòJeÚMtu yeyote ambaye jina lake halikupatikana limeandikwa katika kitabu cha uhai, alitupwa katika ziwa la moto.gòIGÚKisha Kifo na Kuzimu vikatupwa ndani ya ziwa la moto. Ziwa hili la moto ndicho kifo cha pili.!òH‚;Ú
Bahari ikawatoa nje wafu waliokuwa ndani yake; Kifo na Kuzimu vikawatoa nje wafu waliokuwa ndani yao. Kila mmoja akahukumiwa kufuatana na matendo yake.‚òGƒ{ÚKisha nikawaona watu wakubwa na wadogo, wamesimama mbele ya kiti cha enzi, na vitabu vikafunguliwa. Halafu kitabu kingine, yaani kitabu cha uhai, kikafunguliwa pia. Wafu wakahukumiwa kadiri ya matendo yao, kama ilivyoandikwa ndani ya vitabu hivyo.òF‚'ÚKisha, nikaona kiti cha enzi kikubwa cheupe, na yule aketiye juu yake. Dunia na mbingu vikatoweka mbele ya macho yake, na havikuonekana tena.@òE‚yÚ
Naye Ibilisi aliyekuwa anawapotosha, akatupwa ndani ya ziwa linalowaka madini ya kiberiti, walimo yule mnyama na yule nabii wa uongo, nao watateswa mchana na usiku, milele na milele.òD‚!Ú	Walipita katika nchi yote, wakaizunguka kambi ya watakatifu na mji wa Mungu aupendao. Lakini moto ulishuka kutoka mbinguni, ukawaangamiza.QòCƒÚBasi, atatoka nje, ataanza kuyapotosha mataifa yote yaliyotawanyika kila mahali duniani, yaani Gogu na Magogu. Shetani atawakusanya pamoja kwa ajili ya vita; nao watakuwa wengi kama mchanga wa pwani.VòB%ÚWakati miaka 1,000 itakapotimia, Shetani atafunguliwa kutoka gerezani mwake.PòAƒÚWameneemeka sana, tena heri yao wote wanaoshiriki ufufuo huu wa kwanza. Kifo cha pili hakitakuwa na nguvu juu yao; watakuwa makuhani wa Mungu na wa Kristo, na watatawala pamoja naye kwa miaka 1,000.gò@GÚ(Wale wengine waliokufa hawakupata uhai mpaka miaka 1,000 itimie). Huu ndio ufufuo wa kwanza.ƒò?†ÚKisha nikaona viti vya enzi na watu walioketi juu yake; watu hao walipewa mamlaka ya hukumu. Niliona pia roho za wale waliokuwa wamenyongwa kwa sababu ya kumshuhudia Yesu na kwa sababu ya neno la Mungu. Hawa hawakumwabudu yule mnyama na sanamu yake, wala hawakupigwa alama yake juu ya paji za nyuso zao, au juu ya mikono yao. Walipata tena uhai, wakatawala pamoja na Kristo kwa miaka 1,000.rò>ƒ]ÚMalaika akalitupa kuzimu, akaufunga mlango wa kuingilia huko na kuutia mhuri ili lisiweze tena kuyapotosha mataifa mpaka hapo miaka 1,000 itakapotimia. Lakini baada ya miaka hiyo ni lazima lifunguliwe tena, lakini kwa muda mfupi tu.sò=_ÚAkalikamata lile joka â€“ nyoka wa kale, yaani Ibilisi au Shetani â€“ akalifunga kwa muda wa miaka 1,000.}ò<	uÚKisha, nikamwona malaika mmoja anashuka kutoka mbinguni akiwa na ufunguo wa kuzimu na mnyororo mkubwa mkononi mwake. ò;yÚMajeshi yao yaliuawa kwa upanga uliotoka kinywani mwa yule anayepanda farasi. Ndege wote wakajishibisha kwa nyama zao.‚mò:…SÚLakini huyo mnyama akachukuliwa mateka pamoja na nabii wa uongo aliyekuwa akifanya miujiza mbele yake. (Kwa miujiza hiyo, alikuwa amewapotosha wale waliokuwa na chapa ya huyo mnyama, na ambao walikuwa wameiabudu sanamu yake). Huyo mnyama pamoja na huyo nabii walitupwa wote wawili, wakiwa wazimawazima, ndani ya ziwa linalowaka moto wa madini ya kiberiti./ò9‚WÚKisha, nikaona yule mnyama pamoja na mfalme wa dunia na askari wao wamekusanyika pamoja kusudi wapigane na yule aliyekuwa ameketi juu ya farasi pamoja na jeshi lake.Bò8‚}ÚNjoni mkaitafune miili ya wafalme, ya majemadari, ya watu wenye nguvu, ya farasi na wapandafarasi wao; njoni mkaitafune miili ya watu wote: Walio huru na watumwa, wadogo na wakubwa.â€9ò7‚kÚKisha, nikamwona malaika mmoja amesimama katika jua. Akapaza sauti na kuwaambia ndege wote waliokuwa wanaruka juu angani, â€œNjoni! Kusanyikeni pamoja kwa karamu kuu ya Mungu.vò6eÚJuu ya vazi lake, na juu ya paja lake, alikuwa ameandikwa jina: â€œMfalme wa wafalme na Bwana wa mabwana.â€dò5ƒAÚUpanga mkali hutoka kinywani mwake, na kwa upanga huo atawashinda watu wa mataifa. Yeye ndiye atakayetawala kwa fimbo ya chuma na kuikamua divai katika chombo cha kukamulia zabibu za ghadhabu kuu ya Mungu Mwenye Nguvu.rò4]ÚMajeshi ya mbinguni yalimfuata yakiwa yamepanda farasi weupe na yamevaa mavazi ya kitani, meupe na safi.kò3OÚ
Alikuwa amevaa vazi lililokuwa limelowekwa katika damu. Na jina lake huyo ni â€œNeno la Munguâ€."ò2‚=ÚMacho yake ni kama mwali wa moto, na alikuwa amevaa taji nyingi kichwani. Alikuwa ameandikwa jina ambalo hakuna mtu alijuaye isipokuwa tu yeye mwenyewe.?ò1‚wÚKisha, nikaona mbingu zimefunguliwa; na huko alikuwako farasi mmoja mweupe, na mpandafarasi wake aliitwa â€œMwaminifuâ€ na â€œKweliâ€. Huyo huhukumu na kupigana kwa ajili ya haki.ò0ƒwÚ
Basi, mimi nikaanguka kifudifudi mbele ya miguu yake, nikataka kumwabudu. Lakini yeye akaniambia, â€œAcha! Mimi ni mtumishi tu kama wewe na ndugu zako; sote tunamshuhudia Yesu. Mwabudu Mungu! Maana ushuhuda wa Yesu ndio unaowaangazia manabii.â€-ò/‚SÚ	Kisha malaika akaniambia, â€œAndika haya: Heri wale walioalikwa kwenye karamu ya harusi ya Mwanakondoo!â€ Tena akaniambia, â€œHayo ni maneno ya kweli ya Mungu.â€ò.‚!ÚAmepewa uwezo wa kujivalia nguo ya kitani safi, iliyotakata na yenye kung'aa!â€ (Nguo hiyo ya kitani safi ni matendo mema ya watakatifu).wò-gÚTufurahi na kushangilia; tumtukuze, kwani wakati wa harusi ya Mwanakondoo umefika, na bibi arusi yuko tayari.7ò,‚gÚKisha nikasikia kitu kama sauti ya umati mkubwa wa watu na sauti ya maji mengi na ya ngurumo kubwa, ikisema, â€œAsifiwe Mungu! Maana Bwana Mungu wetu Mwenye Nguvu ametawala!ò+‚	ÚKisha, kukatokea sauti kwenye kiti cha enzi: â€œMsifuni Mungu enyi watumishi wake wote, nyote mnaomcha, wadogo kwa wakubwa.â€-ò*‚SÚNa wale wazee ishirini na wanne, na wale viumbe hai wanne, wakajitupa chini, wakamwabudu Mungu aliyeketi juu ya kiti cha enzi wakisema, â€œAmina! Asifiwe Mungu!â€jò)MÚWakasema, â€œAsifiwe Mungu! Moshi wa moto unaoteketeza mji huo utapanda juu milele na milele!â€>ò(‚uÚMaana hukumu yake ni ya kweli na ya haki. Amemhukumu yule mzinzi mkuu ambaye alikuwa ameipotosha dunia kwa uzinzi wake. Amemwadhibu kwa sababu ya kumwaga damu ya watumishi wake!â€%ò'	‚EÚBaada ya hayo nikasikia kitu kama sauti kubwa ya umati wa watu wengi mbinguni ikisema, â€œAsifiwe Mungu! Ukombozi, utukufu na nguvu ni mali yake Mungu wetu!{ò&oÚMji huo uliadhibiwa kwani humo mlipatikana damu ya manabii, damu ya watakatifu na ya watu wote waliouawa duniani.Tò%ƒ!ÚMwanga wa taa hautaonekana tena ndani yako; sauti za bwana arusi na bibi arusi hazitasikika tena ndani yako. Wafanyabiashara wako walikuwa wakuu duniani, na kwa uchawi wako mataifa yote yalipotoshwa!â€dò$ƒAÚSauti za vinubi za muziki, sauti za wapiga filimbi na tarumbeta hazitasikika tena ndani yako. Hakuna fundi wa namna yoyote ile atakayepatikana tena ndani yako; wala sauti ya jiwe la kusagia haitasikika tena ndani yako.(ò#‚IÚKisha, malaika mmoja mwenye nguvu akainua jiwe mfano wa jiwe kubwa la kusagia, akalitupa baharini akisema, â€œNdivyo Babuloni atakavyotupwa na kupotea kabisa..ò"‚UÚâ€œFurahi ee mbingu, kwa sababu ya uharibifu wake. Furahini watu wa Mungu, mitume na manabii! Kwa maana Mungu ameuhukumu kwa sababu ya mambo uliyowatenda nyinyi!â€rò!ƒ]ÚWakajimwagia vumbi juu ya vichwa vyao wakilia kwa sauti na kuomboleza: â€œOle! Ole kwako mji mkuu! Ni mji ambamo wote wenye meli zisafirizo baharini walitajirika kutokana na utajiri wake. Kwa muda wa saa moja tu umepoteza kila kitu!zò mÚna walipouona moshi wa moto ule uliouteketeza, wakalia kwa sauti: â€œHakujapata kuwako mji kama mji huu mkuu!â€ò‚1ÚKwa saa moja tu utajiri wako umetoweka!â€ Halafu manahodha wote na wasafiri wao, wanamaji na wote wanaofanya kazi baharini, walisimama kwa mbali,&ò‚EÚwakisema, â€œOle! Ole kwa mji huu mkuu. Ulizoea kuvalia nguo za kitani, za rangi ya zambarau na nyekundu, na kujipamba kwa dhahabu, mawe ya thamani na lulu!ò‚ÚWafanyabiashara waliotajirika kutokana na mji huo, watasimama mbali kwa sababu ya hofu ya mateso yake, watalalamika na kuomboleza,ò‚ÚWafanyabiashara wanamwambia: â€œFaida yote uliyotazamia imetoweka, na utajiri na fahari vimekuponyoka; hutaweza kuvipata tena!â€&ò‚EÚ
mdalasini, viungo, ubani, manemane, udi, divai, mafuta, unga na ngano, ng'ombe na kondoo, farasi na magari ya kukokotwa, watumwa wao na hata maisha ya watu.‚ò„Úhakuna tena wa kununua dhahabu yao, fedha, mawe ya thamani na lulu, kitani na nguo za rangi ya zambarau, hariri na nguo nyekundu; vyombo vya kila aina ya miti ya pekee, vyombo vya pembe za ndovu, vya miti ya thamani kubwa, vya shaba, chuma na marumaru;mòSÚWafanyabiashara wa dunia watalia na kumfanyia matanga, maana hakuna mtu anayenunua tena bidhaa zao;5ò‚cÚ
Wanasimama kwa mbali kwa sababu ya kuogopa mateso yake na kusema, â€œOle! Ole kwako Babuloni, mji maarufu na wenye nguvu! Kwa muda wa saa moja tu adhabu yako imekupata.â€ò‚'Ú	Wafalme wa dunia waliofanya uzinzi naye na kuishi naye maisha ya anasa wataomboleza na kulia wakati watakapoona moshi wa mji huo unaoteketea.ò‚'ÚKwa sababu hiyo mabaa yake yatampata kwa siku moja: Ugonjwa, huzuni na njaa. Atachomwa moto, maana Bwana Mungu mwenye kumhukumu ana nguvu.â€IòƒÚMpeni mateso na uchungu kadiri ya kujigamba kwake, kulingana na kuishi kwake kwa anasa. Maana anajisemea moyoni: â€˜Ninaketi hapa; mimi ni malkia. Mimi si mjane, wala sitapatwa na uchungu!â€™ò‚ÚMtendeeni kama alivyowatendea nyinyi; mlipeni mara mbili kwa yale aliyoyatenda. Mchanganyieni kikombeni mwake kinywaji kikali maradufu.tòaÚKwa maana dhambi zake zimekuwa nyingi mno, zimerundikana mpaka mbinguni, na Mungu ameyakumbuka maovu yake.'ò‚GÚKisha nikasikia sauti nyingine kutoka mbinguni ikisema, â€œWatu wangu, ondokeni kwake, ili msishirikiane naye katika dhambi zake, msije mkaipata adhabu yake.Jòƒ
ÚMaana mataifa yote yalileweshwa kwa divai kali ya uzinzi wake, nao wafalme wa dunia wamefanya uzinzi naye. Nao wafanyabiashara wa dunia wametajirika kutokana na anasa zake zisizo na kipimo.â€<ò‚qÚBasi, akapaza sauti kwa nguvu akisema, â€œUmeanguka; Babuloni mkuu umeanguka! Sasa umekuwa makao ya mashetani na pepo wachafu; umekuwa makao ya ndege wachafu na wa kuchukiza mno.ò	‚	ÚBaada ya hayo, nilimwona malaika mwingine akishuka kutoka mbinguni. Alikuwa na uwezo mkuu, na dunia ikamulikwa na mng'ao wake.fòEÚâ€œNa yule mwanamke uliyemwona ndio ule mji mkuu ulio na mamlaka juu ya wafalme wa dunia.â€Dò
ƒÚMaana Mungu ametia mioyoni mwao nia ya kutekeleza shabaha yake, yaani wakubaliane wao kwa wao na kumpa huyo mnyama mamlaka yao ya kutawala, mpaka hapo yale aliyosema Mungu yatakapotimia.-ò‚SÚPembe zile kumi ulizoziona na yule mnyama watamchukia huyo mzinzi. Watachukua kila kitu alicho nacho na kumwacha uchi; watakula nyama yake na kumteketeza kwa moto.ò‚ÚMalaika akaniambia pia, â€œYale maji uliyoyaona pale alipokaa yule mzinzi: Ni makundi ya watu wa kila taifa, rangi na lugha.;ò
‚oÚWatapigana na Mwanakondoo, lakini Mwanakondoo pamoja na wale aliowaita na kuwachagua ambao ni waaminifu, atawashinda kwa sababu yeye ni Bwana wa mabwana na Mfalme wa wafalme.â€Yò	+Ú
Shabaha ya hawa kumi ni moja, na watampa yule mnyama nguvu na mamlaka yao yote."ò‚=Úâ€œZile pembe kumi ulizoziona ni wafalme ambao bado hawajaanza kutawala. Lakini watapewa mamlaka ya kutawala kwa muda wa saa moja pamoja na yule mnyama.#ò‚?ÚHuyo mnyama ambaye alikuwa anaishi hapo awali lakini sasa haishi tena ni mfalme wa nane, naye pia ni miongoni mwa hao saba, na anakwenda zake kuharibiwa.ò‚-Ú
Kati ya hao wafalme saba, watano wamekwisha angamia, mmoja anatawala bado na yule mwingine bado hajafika; na atakapofika atabaki kwa muda mfupi.ò‚)Ú	â€œHapa panahitaji akili na hekima! Hivyo vichwa saba ni vilima saba ambavyo huyo mwanamke anaketi juu yake. Vichwa hivyo pia ni wafalme saba.‚ò…wÚHuyo mnyama uliyemwona, alikuwa hai hapo awali lakini sasa amekufa. Hata hivyo, karibu sana atapanda kutoka shimoni kuzimu, lakini ataangamizwa. Wanaoishi duniani watashangaa; naam, watu wote ambao majina yao hayakupata kuandikwa katika kitabu cha uhai tangu mwanzo wa ulimwengu, watashangaa kumwona huyo mnyama ambaye hapo awali aliishi, kisha akafa na sasa anatokea tena!1ò‚[ÚLakini malaika akaniambia, â€œKwa nini unashangaa? Mimi nitakuambia maana iliyofichika ya mwanamke huyu na mnyama huyo amchukuaye ambaye ana vichwa saba na pembe kumi.ò‚'ÚNikamwona huyo mwanamke amelewa damu ya watu wa Mungu, na damu ya watu waliouawa kwa sababu ya kumshuhudia Yesu. Nilipomwona nilishangaa mno.ò‚ÚAlikuwa ameandikwa juu ya paji la uso wake jina la fumbo â€œBabuloni mkuu, mama wa wazinzi na wa mambo yote ya kuchukiza sana duniani.â€ò ƒwÚMwanamke huyo alikuwa amevaa vazi la rangi ya zambarau na nyekundu; alikuwa amejipamba kwa dhahabu, mawe ya thamani na lulu. Mkononi mwake alishika kikombe cha dhahabu ambacho kilikuwa kimejaa machukizo na mambo machafu yanayoonesha uzinzi wake.
